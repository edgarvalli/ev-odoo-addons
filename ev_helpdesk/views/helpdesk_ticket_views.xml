<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <!-- =========================================================
         LISTA DE TICKETS
    ========================================================== -->

    <record id="view_ev_helpdesk_ticket_list" model="ir.ui.view">
        <field name="name">ev.helpdesk.ticket.list</field>
        <field name="model">ev.helpdesk.ticket</field>
        <field name="arch" type="xml">
            <list string="Tickets"
                default_order="date_open desc"
                decoration-danger="priority == '3'"
                decoration-warning="priority == '2'"
                decoration-muted="is_closed">
                <field name="name" />
                <field name="subject" />
                <field name="user_id" />
                <field name="assigned_user_id" />
                <field name="team_id" />
                <field name="category_id" />
                <field name="asset_id" />
                <field name="priority" widget="priority" />
                <field name="stage_id" widget="badge" />
                <field name="date_open" />
            </list>
        </field>
    </record>

    <!-- =========================================================
         FORMULARIO DE TICKET
    ========================================================== -->

    <record id="view_ev_helpdesk_ticket_form" model="ir.ui.view">
        <field name="name">ev.helpdesk.ticket.form</field>
        <field name="model">ev.helpdesk.ticket</field>
        <field name="arch" type="xml">
            <form string="Ticket de soporte">
                <header>
                    <button name="action_assign_to_me"
                        type="object"
                        string="Asignármelo"
                        class="btn-primary"
                        groups="base.group_user" />

                    <button name="action_set_in_progress"
                        type="object"
                        string="Iniciar atención"
                        groups="base.group_user" />

                    <button name="action_close"
                        type="object"
                        string="Cerrar ticket"
                        class="btn-secondary"
                        groups="base.group_user" />

                    <field name="stage_id"
                        widget="statusbar"
                        options="{'clickable': True}" />
                </header>

                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <field name="is_closed" invisible="True" />
                    </div>

                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="True" />
                        </h1>
                        <h2>
                            <field name="subject"
                                placeholder="Describe brevemente el problema" />
                        </h2>
                    </div>

                    <group>
                        <group string="Solicitud">
                            <field name="user_id" />
                            <field name="category_id" />
                            <field name="priority" widget="priority" />
                            <field name="date_open" readonly="True" />
                        </group>

                        <group string="Atención">
                            <field name="team_id" />
                            <field name="assigned_user_id" />
                            <field name="date_assigned" readonly="True" />
                            <field name="date_resolved" readonly="True" />
                            <field name="active" />
                        </group>
                    </group>

                    <group string="Activo relacionado">
                        <field name="asset_id"
                            options="{'no_create': True}"
                            placeholder="Selecciona el activo afectado, si aplica" />
                    </group>

                    <notebook>
                        <page string="Descripción">
                            <field name="description"
                                placeholder="Describe la solicitud, el problema o el requerimiento..." />
                        </page>

                        <page string="Resolución">
                            <field name="resolution"
                                placeholder="Describe la solución aplicada antes de cerrar el ticket..." />
                        </page>
                    </notebook>
                </sheet>

                <chatter />
            </form>
        </field>
    </record>

    <!-- =========================================================
         BÚSQUEDA Y FILTROS
    ========================================================== -->

    <record id="view_ev_helpdesk_ticket_search" model="ir.ui.view">
        <field name="name">ev.helpdesk.ticket.search</field>
        <field name="model">ev.helpdesk.ticket</field>
        <field name="arch" type="xml">
            <search string="Buscar tickets">
                <field name="name" />
                <field name="subject" />
                <field name="user_id" />
                <field name="assigned_user_id" />
                <field name="team_id" />
                <field name="category_id" />
                <field name="asset_id" />
                <field name="stage_id" />

                <separator />

                <filter name="my_requests"
                    string="Mis solicitudes"
                    domain="[('user_id', '=', uid)]" />

                <filter name="assigned_to_me"
                    string="Asignados a mí"
                    domain="[('assigned_user_id', '=', uid)]" />

                <filter name="open_tickets"
                    string="Abiertos"
                    domain="[('is_closed', '=', False)]" />

                <filter name="closed_tickets"
                    string="Cerrados"
                    domain="[('is_closed', '=', True)]" />

                <filter name="high_priority"
                    string="Prioridad alta o urgente"
                    domain="[('priority', 'in', ['2', '3'])]" />

                <group expand="0" string="Agrupar por">
                    <filter name="group_stage"
                        string="Etapa"
                        context="{'group_by': 'stage_id'}" />
                    <filter name="group_assigned_user"
                        string="Responsable"
                        context="{'group_by': 'assigned_user_id'}" />
                    <filter name="group_team"
                        string="Equipo"
                        context="{'group_by': 'team_id'}" />
                    <filter name="group_category"
                        string="Categoría"
                        context="{'group_by': 'category_id'}" />
                    <filter name="group_priority"
                        string="Prioridad"
                        context="{'group_by': 'priority'}" />
                </group>
            </search>
        </field>
    </record>

</odoo>