<odoo>
    <record id="mail_template_ev_helpdesk_ticket_created" model="mail.template">
        <field name="name">EV Helpdesk: Ticket creado</field>
        <field name="model_id" ref="model_ev_helpdesk_ticket" />
        <field name="subject">
            [{{ object.name }}] Ticket creado: {{ object.subject }}
        </field>
        <field name="body_html" type="html">
            <div>
                <p>Hola <t t-out="object.user_id.name" />,</p>

                <p>Tu solicitud de soporte ha sido registrada.</p>

                <ul>
                    <li>
                        <strong>Folio:</strong>
                        <t t-out="object.name" />
                    </li>
                    <li>
                        <strong>Asunto:</strong>
                        <t t-out="object.subject" />
                    </li>
                    <li>
                        <strong>Prioridad:</strong>
                        <t t-out="object.priority" />
                    </li>
                    <li>
                        <strong>Etapa:</strong>
                        <t t-out="object.stage_id.name" />
                    </li>
                </ul>

                <p>El equipo de soporte dará seguimiento a tu solicitud.</p>
            </div>
        </field>
    </record>

    <record id="mail_template_ev_helpdesk_team_ticket_created" model="mail.template">
        <field name="name">EV Helpdesk: Ticket creado</field>
        <field name="model_id" ref="model_ev_helpdesk_ticket" />
        <field name="subject">
            [{{ object.name }}] Ticket creado: {{ object.subject }}
        </field>
        <field name="body_html" type="html">
            <div>
                <p>Hola <t t-out="object.team_id.name" />,</p>
                <p>Una nueva solicitud de soporte ha sido registrada.</p>

                <ul>
                    <li>
                        <strong>Folio:</strong>
                        <t t-out="object.name" />
                    </li>
                    <li>
                        <strong>Asunto:</strong>
                        <t t-out="object.subject" />
                    </li>
                    <li>
                        <strong>Prioridad:</strong>
                        <t t-out="object.priority" />
                    </li>
                    <li>
                        <strong>Etapa:</strong>
                        <t t-out="object.stage_id.name" />
                    </li>
                </ul>
            </div>
        </field>
    </record>


    <record id="mail_template_ev_helpdesk_ticket_assigned" model="mail.template">
        <field name="name">EV Helpdesk: Ticket asignado</field>
        <field name="model_id" ref="model_ev_helpdesk_ticket" />
        <field name="subject">
            [{{ object.name }}] Ticket asignado: {{ object.subject }}
        </field>
        <field name="body_html" type="html">
            <div>
                <p> Hola <t t-out="object.assigned_user_id.name or 'técnico'" />, </p>

                <p>
                    Se te ha asignado un nuevo ticket de soporte.
                    Por favor, revisa la información y da seguimiento a la solicitud.
                </p>

                <ul>
                    <li>
                        <strong>Folio:</strong>
                        <t t-out="object.name" />
                    </li>
                    <li>
                        <strong>Asunto:</strong>
                        <t t-out="object.subject" />
                    </li>
                    <li>
                        <strong>Solicitante:</strong>
                        <t t-out="object.user_id.name" />
                    </li>
                    <li>
                        <strong>Prioridad:</strong>
                        <t
                            t-out="dict(object._fields['priority'].selection).get(object.priority, '')" />
                    </li>
                    <li>
                        <strong>Equipo de soporte:</strong>
                        <t t-out="object.team_id.name or 'Sin equipo asignado'" />
                    </li>
                    <li>
                        <strong>Etapa:</strong>
                        <t t-out="object.stage_id.name" />
                    </li>
                    <li>
                        <strong>Fecha de asignación:</strong>
                        <t t-out="object.date_assigned or ''" />
                    </li>
                </ul>

                <p>
                    <strong>Descripción de la solicitud:</strong>
                </p>
                <div t-out="object.description" />

                <p>
                    Ingresa al sistema de soporte para consultar el ticket
                    y comenzar con su atención.
                </p>

                <p> Saludos,<br /> Equipo de soporte </p>
            </div>
        </field>
    </record>


    <record id="mail_template_ev_helpdesk_ticket_updated" model="mail.template">
        <field name="name">EV Helpdesk: Ticket actualizado</field>
        <field name="model_id" ref="model_ev_helpdesk_ticket" />
        <field name="subject">
            [{{ object.name }}] Actualización: {{ object.subject }}
        </field>
        <field name="body_html" type="html">
            <div>
                <p>Hola <t t-out="object.user_id.name" />,</p>

                <p>Tu ticket ha tenido una actualización.</p>

                <ul>
                    <li>
                        <strong>Folio:</strong>
                        <t t-out="object.name" />
                    </li>
                    <li>
                        <strong>Asunto:</strong>
                        <t t-out="object.subject" />
                    </li>
                    <li>
                        <strong>Técnico asignado:</strong>
                        <t t-out="object.assigned_user_id.name or 'Sin asignar'" />
                    </li>
                    <li>
                        <strong>Etapa:</strong>
                        <t t-out="object.stage_id.name" />
                    </li>
                </ul>

                <div t-if="ctx.get('comment')">
                    <p>
                        <strong>Nuevo comentario:</strong>
                    </p>
                    <div style="white-space: pre-wrap; padding: 10px; background-color: #f5f5f5;">
                        <t t-out="ctx.get('comment')" />
                    </div>
                </div>

                <p>Ingresa al sistema para consultar los detalles del ticket.</p>
            </div>
        </field>
    </record>
</odoo>