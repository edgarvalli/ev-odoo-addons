<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- =========================================================
         ACCIONES TICKETS
    ========================================================== -->

    <record id="action_ev_helpdesk_ticket" model="ir.actions.act_window">
        <field name="name">Todos los tickets</field>
        <field name="res_model">ev.helpdesk.ticket</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_ev_helpdesk_ticket_search" />
        <field name="context">{'search_default_open_tickets': 1}</field>
    </record>

    <record id="action_ev_helpdesk_my_tickets" model="ir.actions.act_window">
        <field name="name">Mis solicitudes</field>
        <field name="res_model">ev.helpdesk.ticket</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_ev_helpdesk_ticket_search" />
        <field name="domain">[('user_id', '=', uid)]</field>
    </record>

    <record id="action_ev_helpdesk_assigned_tickets" model="ir.actions.act_window">
        <field name="name">Tickets asignados a mí</field>
        <field name="res_model">ev.helpdesk.ticket</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_ev_helpdesk_ticket_search" />
        <field name="domain">[('assigned_user_id', '=', uid), ('is_closed', '=', False)]</field>
    </record>

    <record id="action_ev_helpdesk_category" model="ir.actions.act_window">
        <field name="name">Categorías de Soporte</field>
        <field name="res_model">ev.helpdesk.category</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea tu primera categoría de soporte.
            </p>
            <p>
                Organiza los tickets por tipo de incidencia o solicitud.
            </p>
        </field>
    </record>

    <record id="action_ev_helpdesk_team" model="ir.actions.act_window">
        <field name="name">Equipos de Soporte</field>
        <field name="res_model">ev.helpdesk.team</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea tu primer equipo de soporte.
            </p>
            <p>
                Organiza los equipos responsables de atender los tickets.
            </p>
        </field>
    </record>

    <record id="action_ev_helpdesk_stage" model="ir.actions.act_window">
        <field name="name">Etapas de Tickets</field>
        <field name="res_model">ev.helpdesk.stage</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea tu primera etapa.
            </p>
            <p>
                Define las etapas del flujo de atención de los tickets de soporte.
            </p>
        </field>
    </record>

</odoo>