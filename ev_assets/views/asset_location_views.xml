<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- =========================================================
         UBICACIONES
    ========================================================== -->

    <record id="view_ev_asset_location_list" model="ir.ui.view">
        <field name="name">ev.asset.location.list</field>
        <field name="model">ev.asset.location</field>
        <field name="arch" type="xml">
            <list string="Ubicaciones">
                <field name="name" />
                <field name="parent_id" />
                <field name="active" />
            </list>
        </field>
    </record>

    <record id="view_ev_asset_location_form" model="ir.ui.view">
        <field name="name">ev.asset.location.form</field>
        <field name="model">ev.asset.location</field>
        <field name="arch" type="xml">
            <form string="Ubicación">
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="parent_id" />
                        <field name="active" />
                    </group>
                    <group>
                        <field name="description" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>