<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <!-- =========================================================
         ACTIVOS
    ========================================================== -->

    <record id="view_ev_asset_list" model="ir.ui.view">
        <field name="name">ev.asset.list</field>
        <field name="model">ev.asset</field>
        <field name="arch" type="xml">
            <list string="Activos">
                <field name="asset_tag" />
                <field name="name" />
                <field name="category_id" />
                <field name="brand_id" />
                <field name="model_id" />
                <field name="assigned_user_id" />
                <field name="location_id" />
                <field name="state" widget="badge"
                    decoration-success="state == 'available'"
                    decoration-info="state == 'assigned'"
                    decoration-warning="state == 'maintenance'"
                    decoration-danger="state == 'retired'" />
            </list>
        </field>
    </record>

    <record id="view_ev_asset_form" model="ir.ui.view">
        <field name="name">ev.asset.form</field>
        <field name="model">ev.asset</field>
        <field name="arch" type="xml">
            <form string="Activo">
                <sheet>
                    <div class="oe_title">
                        <label for="name" />
                        <h1>
                            <field name="name" placeholder="Nombre del activo" />
                        </h1>
                    </div>

                    <group>
                        <group string="Identificación">
                            <field name="asset_tag" />
                            <field name="serial_number" />
                            <field name="category_id" />
                            <field name="brand_id" />
                            <field name="model_id"
                                domain="[('brand_id', '=', brand_id)]" />
                        </group>

                        <group string="Asignación">
                            <field name="state" />
                            <field name="assigned_user_id" />
                            <field name="location_id" />
                            <field name="active" />
                        </group>
                    </group>

                    <group string="Información de compra">
                        <field name="purchase_date" />
                        <field name="warranty_end" />
                    </group>

                    <notebook>
                        <page string="Observaciones">
                            <field name="notes"
                                placeholder="Información adicional del activo..." />
                        </page>
                    </notebook>
                </sheet>

                <chatter />
            </form>
        </field>
    </record>

    <record id="view_ev_asset_search" model="ir.ui.view">
        <field name="name">ev.asset.search</field>
        <field name="model">ev.asset</field>
        <field name="arch" type="xml">
            <search string="Buscar activos">
                <field name="name" />
                <field name="asset_tag" />
                <field name="serial_number" />
                <field name="category_id" />
                <field name="brand_id" />
                <field name="assigned_user_id" />
                <field name="location_id" />

                <filter name="available"
                    string="Disponibles"
                    domain="[('state', '=', 'available')]" />
                <filter name="assigned"
                    string="Asignados"
                    domain="[('state', '=', 'assigned')]" />
                <filter name="maintenance"
                    string="En mantenimiento"
                    domain="[('state', '=', 'maintenance')]" />
                <filter name="retired"
                    string="Dados de baja"
                    domain="[('state', '=', 'retired')]" />

                <separator />

                <filter name="inactive"
                    string="Archivados"
                    domain="[('active', '=', False)]" />

                <group expand="0" string="Agrupar por">
                    <filter name="group_category"
                        string="Categoría"
                        context="{'group_by': 'category_id'}" />
                    <filter name="group_brand"
                        string="Marca"
                        context="{'group_by': 'brand_id'}" />
                    <filter name="group_state"
                        string="Estado"
                        context="{'group_by': 'state'}" />
                    <filter name="group_location"
                        string="Ubicación"
                        context="{'group_by': 'location_id'}" />
                    <filter name="group_responsible"
                        string="Responsable"
                        context="{'group_by': 'assigned_user_id'}" />
                </group>
            </search>
        </field>
    </record>

</odoo>